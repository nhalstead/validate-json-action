{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": false,
        "strict": true,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "paths": {
            "@actions/core": ["./node_modules/@actions/core/lib/core.js"]
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "ignoreDeprecations": "6.0",
        "lib": ["es2020", "dom"],
        "types": ["node", "jest"]
    },
    "exclude": ["node_modules", "lib", "dist", "coverage", "jest.config.js"],
    "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
