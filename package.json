{
  "name": "validate-json-action",
  "version": "0.1.12",
  "private": true,
  "description": "A Github action for validating JSON",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "npx ncc build src/main.ts -o dist",
    "test": "npm run build && jest",
    "format": "prettier --write '**/*.{ts,js,json}'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhalstead/validate-json-action.git"
  },
  "keywords": [
    "actions",
    "json-schema",
    "ajv"
  ],
  "author": "nhalstead",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-ajv-errors": "^2.0.3",
    "chalk": "^5.6.2",
    "glob": "^13.0.6",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/junit-report-builder": "^3.0.2",
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.1",
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "junit-report-builder": "^5.1.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.0.0",
    "typescript": "^6.0.0"
  }
